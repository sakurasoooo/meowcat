<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>100</ID>
      <Description>"=== Mewgenics (喵星人) 综合辅助 CT 表 ==="</Description>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>1</ID>
          <Description>"[激活] 家园状态核心注入 (House & Save State Hook)"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// Code injection at House Load routine
// AOB: 41 B8 04 00 00 00 48 8D 15 ?? ?? ?? ?? 48 8D 4C 24 30 E8
aobscanmodule(HouseHookAOB,Mewgenics.exe,41 B8 04 00 00 00 48 8D 15 ?? ?? ?? ?? 48 8D 4C 24 30)
alloc(newmem,$1000,HouseHookAOB)

label(code)
label(return)
globalalloc(p_House,8)

newmem:
  mov [p_House],r12

code:
  mov r8d,00000004
  jmp return

HouseHookAOB:
  jmp newmem
  nop
return:
registersymbol(HouseHookAOB)

[DISABLE]
HouseHookAOB:
  db 41 B8 04 00 00 00

unregistersymbol(HouseHookAOB)
dealloc(newmem)
          </AssemblerScript>
          <CheatEntries>
